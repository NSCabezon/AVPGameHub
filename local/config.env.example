# AVP Game Hub — your machine's settings. Copy to local/config.env (gitignored) and fill in.
# Read by klepton/build_run_vpro.sh, klepton/visionos/run.sh, klepton/visionos/stage_alyx.sh,
# klepton/visionos/gen_xcodeproj.py and the Mac app. Anything set in the environment wins.

# Your Apple Developer team id (10 characters). Optional: detected from the login keychain's
# "Apple Development" certificate when unset.
KLEPTON_TEAM=

# Your Vision Pro's UDID (`xcrun devicectl list devices`). Optional: the first paired
# physical Vision Pro is used when unset.
KLEPTON_DEVICE=

# The hub's bundle id. REQUIRED for device builds: an App ID your team can register, under
# your own reverse domain. Keep it once you have installed: game data lives in its container.
KLEPTON_BUNDLE_ID=com.yourname.avpgamehub
