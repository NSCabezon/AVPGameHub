+id<MTLBuffer> MVKCommandEncoder::getFoveationParamBuffer() {
+	if (id<MTLBuffer> b = _fov.getParamBuffer()) { return b; }
+	// A foveated-pass pipeline outside an active foveated instance (a compatible
+	// render pass, or a fallback): an identity map decodes physical == screen. A
+	// screen this large never clamps a real coordinate.
+	const mvkfov::RateMap* idMap = mvkfov::getRateMap(getMTLDevice(), 16384, 16384, 1, true);
+	return idMap ? idMap->params : nil;
+}
+
+// Decides, for the Vulkan render pass instance being begun, whether it renders
+// through the rate map: the render pass object was judged safe at creation
+// (MVKRenderPass::initFoveation); what is left is what only the instance knows.
+void MVKCommandEncoder::fovBeginRenderpass() {
+	_fov.reset();
+	MVKRenderPass* rp = _pEncodingContext->getRenderPass();
+	if ( !rp || !rp->isFoveated() ) { return; }
+
+	// The rate map spans the framebuffer as far as the render area reaches: dynamic
+	// rendering's framebuffer is the whole IMAGE (Alyx: 2688x2880, its largest
+	// dynamic-resolution level) while the eye is drawn into the render area at the
+	// origin (2208x2400 at the default level). A map over the image would centre the
+	// full-rate zone on the image, off the eye's centre.
+	VkExtent2D fbExt = getFramebufferExtent();
+	fbExt.width = std::min<uint32_t>(fbExt.width, std::max(_renderArea.offset.x, 0) + _renderArea.extent.width);
+	fbExt.height = std::min<uint32_t>(fbExt.height, std::max(_renderArea.offset.y, 0) + _renderArea.extent.height);
+	auto& mtlFeats = getMetalFeatures();
+	const char* why = nullptr;
+	uint32_t layers = 0;
+	for (uint32_t i = 0; i < rp->getSubpassCount(); i++) {
+		MVKRenderSubpass* sp = rp->getSubpass(i);
+		uint32_t spLayers;
+		if (sp->isMultiview()) {
+			if (sp->getMultiviewMetalPassCount() != 1) { why = "the multiview pass is split into several Metal passes"; break; }
+			spLayers = sp->getViewCountInMetalPass(0);
+		} else {
+			spLayers = std::max(getFramebufferLayerCount(), 1u);
+		}
+		if (layers && spLayers != layers) { why = "subpasses render different layer counts"; break; }
+		layers = spLayers;
+		if (layers > 1 && !(mtlFeats.layeredRendering && (mtlFeats.multisampleLayeredRendering || sp->getSampleCount() == VK_SAMPLE_COUNT_1_BIT))) {
+			why = "layered rendering is unavailable for this pass"; break;
+		}
+	}
+	if ( !why && layers > 2 ) { why = "more than 2 layers"; }
+	if ( !why && (!fbExt.width || !fbExt.height) ) { why = "the framebuffer has no extent"; }
+	const mvkfov::RateMap* rm = why ? nullptr : mvkfov::getRateMap(getMTLDevice(), fbExt.width, fbExt.height, layers, false);
+	if ( !why && !rm ) { why = "no rate map for it"; }
+	// KL_FOVEATE_AB: the full-rate half of an in-process A/B. Sticky across the
+	// segments of one suspended/resumed instance (Alyx splits its scene pass in four).
+	bool abOff = false;
+	if ( !why ) {
+		bool resuming = mvkIsAnyFlagEnabled(rp->getRenderingFlags(), VK_RENDERING_RESUMING_BIT);
+		if (resuming && rp->_fovABOffSticky >= 0) {
+			abOff = rp->_fovABOffSticky;
+		} else {
+			abOff = mvkfov::isABOffPhase();
+			rp->_fovABOffSticky = abOff ? 1 : 0;
+		}
+	}
+
+	_fov.active = !why && !abOff;
+	_fov.rateMap = rm;
+	_fov.layers = std::max(layers, 1u);
+	_fov.renderArea = _renderArea;
+	_fov.isDensityMapPass = true;
+	if (abOff) { _fov.rateMap = nullptr; return; }		// identity map for the pipelines, nothing logged
+	if (why) {
+		char key[160];
+		snprintf(key, sizeof(key), "begin:%s", why);
+		mvkfov::logOnce(key, "[mvk-fov] a density-map render pass instance renders at FULL RATE: %s (logged once)\n", why);
+	} else {
+		char key[96];
+		snprintf(key, sizeof(key), "beginok:%ux%u:%u", fbExt.width, fbExt.height, layers);
+		mvkfov::logOnce(key, "[mvk-fov] foveating a %ux%u x%u render pass: shading %lux%lu per layer\n",
+						fbExt.width, fbExt.height, layers, (unsigned long)rm->physical.width, (unsigned long)rm->physical.height);
+	}
+}
+
+// Swaps every attachment texture of a Metal render pass of the foveated instance
+// for its shadow, and attaches the rate map. Called for each Metal render pass the
+// instance begins (subpasses, restarts), so a shadow found in _fov.targets keeps
+// its contents across them; a new one is fetched from the pool.
+void MVKCommandEncoder::fovSubstitute(MTLRenderPassDescriptor* mtlRPDesc) {
+	MVKRenderPass* rp = _pEncodingContext->getRenderPass();
+	MVKRenderSubpass* sp = getSubpass();
+	const mvkfov::RateMap* rm = _fov.rateMap;
+	id<MTLDevice> mtlDev = getMTLDevice();
+	bool ok = true;
+
+	// `want` masks what this descriptor slot can owe the real image: a resolve slot of a
+	// depth/stencil image owes only its own aspect (depth OR stencil), since the two
+	// aspects resolve through separate Metal slots into the same texture.
+	auto shadowFor = [&](id<MTLTexture> real, NSUInteger slice, NSUInteger level, uint32_t slot, uint32_t attIdx, bool isDepthStencil, uint8_t want) -> id<MTLTexture> {
+		uint8_t kind = rp->fovUnwarpKind(attIdx) & want;
+		for (auto& t : _fov.targets) {
+			if (t.real == real && t.realSlice == slice && t.realLevel == level) {
+				t.unwarp |= kind;
+				return t.shadow;
+			}
+		}
+		id<MTLTexture> sh = mvkfov::getShadow(mtlDev, real, rm->physical, _fov.layers, slot, _mtlCmdBuffer);
+		if ( !sh ) { return nil; }
+		MVKFovTarget t;
+		t.real = real;
+		t.realSlice = slice;
+		t.realLevel = level;
+		t.shadow = sh;
+		t.isDepthStencil = isDepthStencil;
+		t.unwarp = kind;
+		_fov.targets.push_back(t);
+		return sh;
+	};
+
+	for (uint32_t i = 0; i < 8 && ok; i++) {
+		MTLRenderPassColorAttachmentDescriptor* ca = mtlRPDesc.colorAttachments[i];
+		if (ca.texture) {
+			id<MTLTexture> sh = shadowFor(ca.texture, ca.slice, ca.level, i, sp->getColorAttachmentIndex(i), false, kMVKFovUnwarpColor);
+			if (sh) { ca.texture = sh; ca.slice = 0; ca.level = 0; ca.depthPlane = 0; } else { ok = false; }
+		}
+		if (ca.resolveTexture && ok) {
+			id<MTLTexture> sh = shadowFor(ca.resolveTexture, ca.resolveSlice, ca.resolveLevel, 10 + i, sp->getResolveAttachmentIndex(i), false, kMVKFovUnwarpColor);
+			if (sh) { ca.resolveTexture = sh; ca.resolveSlice = 0; ca.resolveLevel = 0; ca.resolveDepthPlane = 0; } else { ok = false; }
+		}
+	}
+	MTLRenderPassDepthAttachmentDescriptor* da = mtlRPDesc.depthAttachment;
+	MTLRenderPassStencilAttachmentDescriptor* sa = mtlRPDesc.stencilAttachment;
+	uint32_t dsAtt = sp->getDepthStencilAttachmentIndex();
+	if (ok && da.texture) {
+		id<MTLTexture> sh = shadowFor(da.texture, da.slice, da.level, 8, dsAtt, true, kMVKFovUnwarpDepth | kMVKFovUnwarpStencil);
+		if (sh) { da.texture = sh; da.slice = 0; da.level = 0; } else { ok = false; }
+	}
+	if (ok && da.resolveTexture) {
+		id<MTLTexture> sh = shadowFor(da.resolveTexture, da.resolveSlice, da.resolveLevel, 18, sp->getDepthResolveAttachmentIndex(), true, kMVKFovUnwarpDepth);
+		if (sh) { da.resolveTexture = sh; da.resolveSlice = 0; da.resolveLevel = 0; } else { ok = false; }
+	}
+	if (ok && sa.texture) {
+		// A combined depth/stencil image is ONE texture: shadowFor finds the depth's shadow.
+		id<MTLTexture> sh = shadowFor(sa.texture, sa.slice, sa.level, 9, sp->getStencilAttachmentIndex(), true, kMVKFovUnwarpDepth | kMVKFovUnwarpStencil);
+		if (sh) { sa.texture = sh; sa.slice = 0; sa.level = 0; } else { ok = false; }
+	}
+	if (ok && sa.resolveTexture) {
+		id<MTLTexture> sh = shadowFor(sa.resolveTexture, sa.resolveSlice, sa.resolveLevel, 19, sp->getStencilResolveAttachmentIndex(), true, kMVKFovUnwarpStencil);
+		if (sh) { sa.resolveTexture = sh; sa.resolveSlice = 0; sa.resolveLevel = 0; } else { ok = false; }
+	}
+	if ( !ok ) {
+		// Cannot happen short of running out of memory; the substituted slots would
+		// point at shadows nobody unwarps. Fail loudly rather than render garbage.
+		reportError(VK_ERROR_OUT_OF_DEVICE_MEMORY, "[mvk-fov] could not allocate a shadow attachment");
+		return;
+	}
+	// renderTargetWidth/Height stay in SCREEN space (what MoltenVK set: the render
+	// area's extent): with a rate map, Metal validates viewports and scissors against
+	// them in screen coordinates, while the attachments are physical. Setting the
+	// physical size here clips the rasterizer and fails scissor validation (measured:
+	// a GPU page fault in Alyx's first foveated frame).
+	mtlRPDesc.rasterizationRateMap = rm->map;
+}
+
+// The end of a foveated instance: for every attachment the game keeps, one
+// full-screen pass on the REAL image, all layers at once (instanced, layered),
+// sampling the shadow through the rate map. Scissored to the render area, and
+// loading the real image when the render area does not cover it, so pixels
+// outside the area survive as Vulkan requires.
+void MVKCommandEncoder::fovUnwarp() {
+	const mvkfov::RateMap* rm = _fov.rateMap;
+	id<MTLDevice> mtlDev = getMTLDevice();
+	uint32_t opts = mvkfov::getUnwarpOptions();
+	for (auto& t : _fov.targets) {
+		if ( !t.unwarp || t.shadow.storageMode == MTLStorageModeMemoryless ) { continue; }
+		MTLPixelFormat fmt = t.real.pixelFormat;
+		uint8_t kind = t.isDepthStencil ? (t.unwarp & (kMVKFovUnwarpDepth | kMVKFovUnwarpStencil)) : kMVKFovUnwarpColor;
+		if (t.isDepthStencil && !mvkfov::isDepthUnwarpEnabled()) { continue; }	// KL_FOVEATE_DEPTH=0: the A/B for its cost
+		MTLPixelFormat stFmt = mvkfov::stencilViewFormat(fmt);
+		if (stFmt == MTLPixelFormatInvalid) { kind &= ~kMVKFovUnwarpStencil; }
+		if ( !kind ) { continue; }
+		id<MTLRenderPipelineState> pso = mvkfov::getUnwarpPipeline(mtlDev, fmt, kind);
+		if ( !pso ) { continue; }		// logged once by getUnwarpPipeline
+		bool hasStencil = t.isDepthStencil && stFmt != MTLPixelFormatInvalid;
+		bool hasDepthPlane = t.isDepthStencil && fmt != MTLPixelFormatStencil8;
+
+		NSUInteger w = std::max<NSUInteger>(1, t.real.width >> t.realLevel);
+		NSUInteger h = std::max<NSUInteger>(1, t.real.height >> t.realLevel);
+		VkRect2D ra = _fov.renderArea;
+		NSUInteger sx = std::min<NSUInteger>((NSUInteger)std::max(ra.offset.x, 0), w);
+		NSUInteger sy = std::min<NSUInteger>((NSUInteger)std::max(ra.offset.y, 0), h);
+		NSUInteger sw = std::min<NSUInteger>(ra.extent.width, w - sx);
+		NSUInteger sh = std::min<NSUInteger>(ra.extent.height, h - sy);
+		if ( !sw || !sh ) { continue; }
+		// A render area anchored at the origin (Alyx's dynamic resolution draws the eye
+		// into the top-left of a bigger image) is the WHOLE unwarp pass: its render
+		// target is cut to the area, every pixel of it is written, and nothing has to
+		// be loaded first. Otherwise the pixels outside the scissor must survive.
+		bool entire = (sx == 0 && sy == 0);
+
+		MTLRenderPassDescriptor* desc = [MTLRenderPassDescriptor renderPassDescriptor];
+		// A combined depth/stencil image is attached whole. An aspect this unwarp does not
+		// write is loaded (when the image is bigger than the render area) or left alone.
+		auto setAtt = [&](MTLRenderPassAttachmentDescriptor* att, bool written) {
+			att.texture = t.real;
+			att.slice = t.realSlice;
+			att.level = t.realLevel;
+			att.loadAction = (entire && written) ? MTLLoadActionDontCare : MTLLoadActionLoad;
+			att.storeAction = MTLStoreActionStore;
+		};
+		if ( !t.isDepthStencil ) { setAtt(desc.colorAttachments[0], true); }
+		if (hasDepthPlane) { setAtt(desc.depthAttachment, kind & kMVKFovUnwarpDepth); }
+		if (hasStencil) { setAtt(desc.stencilAttachment, kind & kMVKFovUnwarpStencil); }
+		if (_fov.layers > 1) { desc.renderTargetArrayLength = _fov.layers; }
+		if (entire) { desc.renderTargetWidth = sw; desc.renderTargetHeight = sh; }
+
+		id<MTLRenderCommandEncoder> enc = [_mtlCmdBuffer renderCommandEncoderWithDescriptor: desc];
+		if ( !enc ) { continue; }
+		_cmdBuffer->setMetalObjectLabel(enc, @"Klepton foveation unwarp");
+		barrierWait(kMVKBarrierStageFragment, enc, MTLRenderStageFragment);
+		[enc setRenderPipelineState: pso];
+		id<MTLTexture> stencilView = nil;
+		if (t.isDepthStencil) {
+			[enc setDepthStencilState: mvkfov::getUnwarpDepthState(mtlDev, kind)];
+			if (kind & kMVKFovUnwarpStencil) {
+				// Cached with the shadow: the command buffer does not retain it.
+				stencilView = mvkfov::getShadowStencilView(t.shadow);
+				[enc setFragmentTexture: stencilView atIndex: 1];
+			}
+		}
+		// The viewport spans the screen the rate map was made for, in that screen's
+		// pixel coordinates; the scissor keeps the draw inside the render area.
+		NSUInteger rtw = entire ? sw : w, rth = entire ? sh : h;
+		[enc setViewport: (MTLViewport){ 0, 0, (double)rtw, (double)rth, 0, 1 }];
+		[enc setScissorRect: (MTLScissorRect){ sx, sy, sw, sh }];
+		[enc setFragmentBuffer: rm->params offset: 0 atIndex: 0];
+		[enc setFragmentBytes: &opts length: sizeof(opts) atIndex: 1];
+		[enc setFragmentTexture: t.shadow atIndex: 0];
+		[enc drawPrimitives: MTLPrimitiveTypeTriangle vertexStart: 0 vertexCount: 3 instanceCount: _fov.layers];
+		barrierUpdate(kMVKBarrierStageFragment, enc, MTLRenderStageFragment);
+		[enc endEncoding];
+	}
+}
