+// Klepton FDM: find the density map, and decide once, for the render pass object,
+// whether its instances can be foveated safely. The rules are in MVKFoveation.h;
+// each refusal is logged once per distinct reason (render passes are re-created
+// with the same shape all the time). _fovUnwarp records, per attachment, what the
+// end of an instance owes the real image (kMVKFovUnwarp* bits: colour, depth, stencil).
+void MVKRenderPass::initFoveation(const void* pNext) {
+	for (auto* next = (const VkBaseInStructure*)pNext; next; next = next->pNext) {
+		if (next->sType == VK_STRUCTURE_TYPE_RENDER_PASS_FRAGMENT_DENSITY_MAP_CREATE_INFO_EXT) {
+			_fdmAttachment = ((const VkRenderPassFragmentDensityMapCreateInfoEXT*)next)->fragmentDensityMapAttachment.attachment;
+		}
+		// Dynamic rendering (what Source 2 uses): the map is a view of its own, not one
+		// of the attachments, so it is marked present with an index past them.
+		if (next->sType == VK_STRUCTURE_TYPE_RENDERING_FRAGMENT_DENSITY_MAP_ATTACHMENT_INFO_EXT &&
+			((const VkRenderingFragmentDensityMapAttachmentInfoEXT*)next)->imageView) {
+			_fdmAttachment = (uint32_t)_attachments.size();
+		}
+	}
+	if (_fdmAttachment == VK_ATTACHMENT_UNUSED || !mvkfov::isEnabled()) { return; }
+
+	MVKPixelFormats* pixFmts = getPixelFormats();
+	uint32_t attCnt = (uint32_t)_attachments.size();
+	_fovUnwarp.resize(attCnt);
+	for (uint32_t i = 0; i < attCnt; i++) { _fovUnwarp[i] = 0; }
+	char why[256] = {0};
+	auto refuse = [&](const char* fmt, uint32_t a, int v) { if ( !why[0] ) { snprintf(why, sizeof(why), fmt, a, v); } };
+	auto hasStencil = [&](VkFormat f) { return pixFmts->isStencilFormat(pixFmts->getMTLPixelFormat(f)); };
+
+	for (auto& sp : _subpasses) {
+		for (size_t k = 0; k < sp._colorAttachments.size(); k++) {
+			uint32_t a = sp._colorAttachments[k].attachment;
+			if (a == VK_ATTACHMENT_UNUSED || a >= attCnt) { continue; }
+			auto& ad = _attachments[a]._info;
+			MVKFormatType ft = pixFmts->getFormatType(ad.format);
+			if (ft != kMVKFormatColorFloat && ft != kMVKFormatColorHalf) { refuse("colour attachment %u is not a float/unorm format (vk %d)", a, ad.format); }
+			if (ad.loadOp == VK_ATTACHMENT_LOAD_OP_LOAD) { refuse("colour attachment %u is LOADED (loadOp %d)", a, ad.loadOp); }
+			if (ad.storeOp == VK_ATTACHMENT_STORE_OP_STORE) {
+				if (ad.samples != VK_SAMPLE_COUNT_1_BIT) { refuse("colour attachment %u is multisampled (%d) and STORED", a, ad.samples); }
+				_fovUnwarp[a] |= kMVKFovUnwarpColor;
+			}
+			uint32_t r = k < sp._resolveAttachments.size() ? sp._resolveAttachments[k].attachment : VK_ATTACHMENT_UNUSED;
+			if (r != VK_ATTACHMENT_UNUSED && r < attCnt) {
+				auto& rd = _attachments[r]._info;
+				if ( !mvkAreAllFlagsEnabled(pixFmts->getCapabilities(rd.format), kMVKMTLFmtCapsResolve) ) {
+					refuse("resolve attachment %u: Metal cannot resolve its format (vk %d)", r, rd.format);
+				}
+				_fovUnwarp[r] |= kMVKFovUnwarpColor;
+			}
+		}
+		uint32_t d = sp._depthAttachment.attachment;
+		if (d == VK_ATTACHMENT_UNUSED) { d = sp._stencilAttachment.attachment; }
+		if (d != VK_ATTACHMENT_UNUSED && d < attCnt) {
+			auto& dd = _attachments[d]._info;
+			bool st = hasStencil(dd.format);
+			if (dd.loadOp == VK_ATTACHMENT_LOAD_OP_LOAD) { refuse("depth attachment %u is LOADED (loadOp %d)", d, dd.loadOp); }
+			if (st && dd.stencilLoadOp == VK_ATTACHMENT_LOAD_OP_LOAD) { refuse("stencil of attachment %u is LOADED (%d)", d, dd.stencilLoadOp); }
+			if (st && dd.stencilStoreOp == VK_ATTACHMENT_STORE_OP_STORE) { refuse("stencil of attachment %u is STORED (%d)", d, dd.stencilStoreOp); }
+			if (dd.storeOp == VK_ATTACHMENT_STORE_OP_STORE) {
+				if (dd.samples != VK_SAMPLE_COUNT_1_BIT) { refuse("depth attachment %u is multisampled (%d) and STORED", d, dd.samples); }
+				_fovUnwarp[d] |= kMVKFovUnwarpDepth;
+			}
+		}
+		uint32_t sa = sp._stencilAttachment.attachment;
+		if (sa != VK_ATTACHMENT_UNUSED && sa < attCnt && sa != d) {
+			auto& sd = _attachments[sa]._info;
+			if (sd.loadOp == VK_ATTACHMENT_LOAD_OP_LOAD || sd.stencilLoadOp == VK_ATTACHMENT_LOAD_OP_LOAD) { refuse("stencil attachment %u is LOADED (%d)", sa, sd.loadOp); }
+			if (sd.storeOp == VK_ATTACHMENT_STORE_OP_STORE || sd.stencilStoreOp == VK_ATTACHMENT_STORE_OP_STORE) { refuse("stencil attachment %u is STORED (%d)", sa, sd.storeOp); }
+		}
+		uint32_t dr = sp._depthResolveAttachment.attachment;
+		if (dr != VK_ATTACHMENT_UNUSED && dr < attCnt && sp._depthResolveMode != VK_RESOLVE_MODE_NONE) { _fovUnwarp[dr] |= kMVKFovUnwarpDepth; }
+		// A resolved stencil is unwarped too, through a [[stencil]] fragment output
+		// (Alyx resolves depth AND stencil of its scene pass into one D32S8 image).
+		uint32_t sr = sp._stencilResolveAttachment.attachment;
+		if (sr != VK_ATTACHMENT_UNUSED && sr < attCnt && sp._stencilResolveMode != VK_RESOLVE_MODE_NONE) { _fovUnwarp[sr] |= kMVKFovUnwarpStencil; }
+		for (auto& ia : sp._inputAttachments) {
+			if (ia.attachment != VK_ATTACHMENT_UNUSED && ia.attachment < attCnt &&
+				_attachments[ia.attachment]._info.loadOp == VK_ATTACHMENT_LOAD_OP_LOAD) {
+				refuse("input attachment %u is LOADED (%d)", ia.attachment, 1);
+			}
+		}
+	}
+	// The density map itself is never rendered to or unwarped.
+	if (_fdmAttachment < attCnt) { _fovUnwarp[_fdmAttachment] = 0; }
+
+	_isFoveated = !why[0];
+	char key[300];
+	snprintf(key, sizeof(key), "rp:%s:%u:%zu", why, attCnt, _subpasses.size());
+	if (_isFoveated) {
+		uint32_t nUnwarp = 0;
+		for (auto u : _fovUnwarp) { nUnwarp += u ? 1 : 0; }
+		mvkfov::logOnce(key, "[mvk-fov] render pass with a density map (attachment %u of %u, %zu subpass(es)): FOVEATED, %u attachment(s) unwarped at the end\n",
+						_fdmAttachment, attCnt, _subpasses.size(), nUnwarp);
+	} else {
+		mvkfov::logOnce(key, "[mvk-fov] render pass with a density map (attachment %u of %u): FULL RATE — %s\n",
+						_fdmAttachment, attCnt, why);
+	}
+}
