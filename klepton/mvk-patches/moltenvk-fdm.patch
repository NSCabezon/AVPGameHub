+// MoltenVK below reads VkRenderPassFragmentDensityMapCreateInfoEXT. Bump on any
+// change to what the layer must pass through.
+extern "C" MVK_PUBLIC_SYMBOL int klMVKFoveationABI(void) { return 1; }
+
+extern "C" MVK_PUBLIC_SYMBOL void klMVKFoveationSetEnabled(int on) {
+	bool off = !on;
+	if (mvkfov::s_liveOff.exchange(off) != off) {
+		fprintf(stderr, "[mvk-fov] foveation %s live (klMVKFoveationSetEnabled)\n", on ? "ON" : "OFF");
+	}
+}
