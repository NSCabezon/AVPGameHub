+ * rate maps (fixed foveated rendering). Not part of upstream MoltenVK.
+ *
+ * WHAT IT DOES
+ *   A render pass created with VkRenderPassFragmentDensityMapCreateInfoEXT (the
+ *   extension itself is advertised to the guest by Klepton's libvulkan layer,
+ *   runtime/gfx/kl_vulkan.c — this fork never advertises it) is, when
+ *   KL_FOVEATE=1 and the pass passes the safety checks below, rendered through an
+ *   MTLRasterizationRateMap:
+ *     - every attachment of the pass is replaced, for the duration of the
+ *       Vulkan render pass instance, by a SHADOW texture of the rate map's
+ *       PHYSICAL (reduced) size, same format / sample count / layer count;
+ *     - the Metal render pass carries the rate map, so the rasterizer shades the
+ *       periphery at 1/2, 1/3, 1/4 rate (KL_FOVEATE_LEVEL) while viewports and
+ *       scissors stay in framebuffer coordinates (Metal maps them);
+ *     - pipelines compiled for such a pass remap gl_FragCoord from physical to
+ *       framebuffer coordinates (SPIRV-Cross option rasterization_rate_map_fragcoord,
+ *       a Klepton patch), because Vulkan FDM keeps gl_FragCoord in framebuffer space;
+ *     - when the render pass ends, every attachment the game keeps (storeOp STORE,
+ *       and every resolve target) is UNWARPED: a full-screen pass per attachment
+ *       samples the shadow through the rate map into the real, full-size image.
+ *   The game's own density map is NOT read: the rate is a fixed separable profile
+ *   (Metal rate maps are separable per axis; Vulkan maps are 2-D), chosen by
+ *   KL_FOVEATE_LEVEL. Identical on every layer (both eyes).
+ *
+ * WHAT FALLS BACK TO FULL RATE (logged once per render pass, by reason)
+ *   - any attachment loaded (LOAD_OP_LOAD): the shadow would need the old
+ *     contents warped in first — not implemented;
+ *   - a multisampled attachment that is STORED (resolve is fine);
+ *   - stored stencil; integer colour formats; formats Metal cannot resolve;
+ *   - at begin time: a multiview pass MoltenVK splits into several Metal passes,
+ *     more than 2 layers, or a rate map the device refuses.
+ *   A pipeline compiled for a foveatable pass that ends up running at full rate
+ *   is fed an IDENTITY rate map, so its gl_FragCoord remap is a no-op.
+ *
+ * KNOBS (read once, from the environment)
+ *   KL_FOVEATE=1            enable (default 0: the struct is ignored, as stock)
+ *   KL_FOVEATE_LEVEL=1..3   1 mild (~64% of fragments), 2 default (~38%), 3 (~26%)
+ *   KL_FOVEATE_PROFILE=...  "f:r,f:r,..." centre-to-edge half-axis zones (fraction
+ *                           of the half extent, rate), overrides the level
+ *   KL_FOVEATE_UNWARP=nearest  point-sample the unwarp (default linear)
+ *   KL_FOVEATE_DEBUG=1      tint the periphery of unwarped colour (rate < 1) red
+ *   KL_FOVEATE_DEPTH=0      do not unwarp resolved depth/stencil (diagnostic)
+ *   KL_MVK_GPU_TIME=1       log GPU busy time (MTLCommandBuffer GPUStart/EndTime)
+ *                           every 5 s, union of all command buffers
+ *   KL_FOVEATE_AB=<s>       in-process A/B: foveation ON/OFF alternating every s
+ *                           seconds; per-phase GPU ms per frame (implies GPU time)
+ */
+
+#pragma once
+
+#import <Metal/Metal.h>
+#include <vulkan/vulkan.h>
+#include <cstdint>
+#include <vector>
+
+class MVKCommandEncoder;
+class MVKRenderPass;
+
+/** Global configuration and helpers. All functions are thread-safe. */
+namespace mvkfov {
+
+	/** KL_FOVEATE. */
+	bool isEnabled();
+
+	/** A rate map (shared, cached by size, layers and profile) with its parameter buffer. */
+	struct RateMap {
+		id<MTLRasterizationRateMap> map = nil;
+		id<MTLBuffer> params = nil;		// copyParameterDataToBuffer, bound for the gl_FragCoord remap
+		MTLSize physical = {0, 0, 0};	// max over layers (identical layers)
+		uint32_t screenW = 0, screenH = 0, layers = 0;
+		bool identity = false;
+		double fragmentRatio = 1.0;		// physical area / screen area
+	};
+
+	/**
+	 * Returns the cached rate map for the screen size and layer count, or nullptr if the
+	 * device cannot make one. identity = true returns a rate-1 map (a no-op decoder).
+	 */
+	const RateMap* getRateMap(id<MTLDevice> mtlDev, uint32_t w, uint32_t h, uint32_t layers, bool identity);
+
+	/**
+	 * A shadow attachment for `real`: same pixel format and sample count, `physical` size,
+	 * `layers` slices (always an array texture), private storage unless `real` is memoryless.
+	 * Pooled by shape and `slot` (the Metal descriptor slot), so two attachments of one pass
+	 * never share a shadow while successive passes reuse them. Returns nil on failure.
+	 */
+	id<MTLTexture> getShadow(id<MTLDevice> mtlDev, id<MTLTexture> real, MTLSize physical, uint32_t layers, uint32_t slot,
+							 id<MTLCommandBuffer> mtlCmdBuff);
+
+	/** The stencil-plane view of a pooled depth/stencil shadow (cached with it), or nil. */
+	id<MTLTexture> getShadowStencilView(id<MTLTexture> shadow);
+
+	/**
+	 * The unwarp pipeline for a destination: kind is kMVKFovUnwarp* bits (colour, or depth
+	 * and/or stencil); fmt is the destination's pixel format (a combined depth/stencil
+	 * format is attached as both).
+	 */
+	id<MTLRenderPipelineState> getUnwarpPipeline(id<MTLDevice> mtlDev, MTLPixelFormat fmt, uint8_t kind);
+
+	/** Depth/stencil state for the depth/stencil unwarp: always pass, write what kind asks. */
+	id<MTLDepthStencilState> getUnwarpDepthState(id<MTLDevice> mtlDev, uint8_t kind);
+
+	/** The stencil-only view pixel format of a depth/stencil format, or Invalid. */
+	MTLPixelFormat stencilViewFormat(MTLPixelFormat fmt);
+
+	/** KL_FOVEATE_DEPTH (default 1): unwarp stored/resolved depth and stencil. 0 is a diagnostic. */
+	bool isDepthUnwarpEnabled();
+
+	/** Unwarp options word bound at fragment buffer 1: bit 0 nearest, bit 1 debug tint. */
+	uint32_t getUnwarpOptions();
+
+	/** Notes a command buffer's GPU interval for KL_MVK_GPU_TIME. */
+	void noteGPUTime(double start, double end);
+	bool isGPUTimeEnabled();
+
+	/**
+	 * Counts one FRAME of a density-map pass (its last segment ending), foveated or not,
+	 * for the periodic log line and the in-process A/B.
+	 */
+	void noteFrame(bool foveated);
+
+	/**
+	 * KL_FOVEATE_AB=<s>: alternate foveation ON / OFF every s seconds inside one run, and
+	 * report GPU ms per frame for each phase. Two runs on a shared, busy GPU are not
+	 * comparable; two phases of one run, interleaved for minutes, are. Returns whether
+	 * the current phase is OFF (the instance renders at full rate through the identity map).
+	 */
+	bool isABOffPhase();
+
+	/** Logs a message at most once per key string. */
+	void logOnce(const char* key, const char* fmt, ...) __printflike(2, 3);
+}
+
+/** What the end of a foveated render pass instance owes an attachment's real image. */
+enum : uint8_t {
+	kMVKFovUnwarpColor   = 1,
+	kMVKFovUnwarpDepth   = 2,
+	kMVKFovUnwarpStencil = 4,
+};
+
+/** Exported for Klepton's libvulkan layer: the foveation ABI this MoltenVK implements (1). */
+extern "C" int klMVKFoveationABI(void);
+
+/**
+ * Exported for Klepton: foveation on (1) or off (0) from the next render pass instance,
+ * without rebuilding anything — off renders density-map passes through the identity map
+ * (full rate), exactly as KL_FOVEATE_AB's off phase does. Default on.
+ */
+extern "C" void klMVKFoveationSetEnabled(int on);
+
+/** One attachment of a foveated render pass instance: the real image and its shadow. */
+struct MVKFovTarget {
+	id<MTLTexture> real = nil;
+	NSUInteger realSlice = 0;
+	NSUInteger realLevel = 0;
+	id<MTLTexture> shadow = nil;
+	bool isDepthStencil = false;	// a depth and/or stencil format
+	uint8_t unwarp = 0;				// kMVKFovUnwarp* bits the real image must receive at the end
+};
+
+/** Per command encoder state for the Vulkan render pass instance being encoded. */
+struct MVKFoveationPassState {
+	const mvkfov::RateMap* rateMap = nullptr;	// active map, or identity map for a fallback
+	bool active = false;						// shadows + rate map in effect
+	bool isDensityMapPass = false;				// a foveatable density-map pass, active or not
+	uint32_t layers = 1;
+	VkRect2D renderArea = {};
+	std::vector<MVKFovTarget> targets;
+
+	void reset() { rateMap = nullptr; active = false; isDensityMapPass = false; layers = 1; renderArea = {}; targets.clear(); }
+
+	/** The rate-map parameter buffer for the gl_FragCoord remap, or nil outside a density-map pass. */
+	id<MTLBuffer> getParamBuffer() const { return rateMap ? rateMap->params : nil; }
+};
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKFoveation.mm b/MoltenVK/MoltenVK/GPUObjects/MVKFoveation.mm
new file mode 100644
index 0000000..cd824aa
--- /dev/null
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKFoveation.mm
@@ -0,0 +1,603 @@
+/*
+ * MVKFoveation.mm
+ *
+ * Klepton fork: fixed foveated rendering for VK_EXT_fragment_density_map render
+ * passes over MTLRasterizationRateMap. See MVKFoveation.h for the contract.
+ *
+ * Compiled as part of MVKRenderPass.mm (#include at its end), so the Xcode
+ * project needs no new file reference; the MVKCommandEncoder half lives in
+ * MVKCommandBuffer.mm (fov* functions).
+ */
+
+#include "MVKFoveation.h"
+#include "MVKCommonEnvironment.h"
+#import <QuartzCore/QuartzCore.h>
+#include <mutex>
+#include <string>
+#include <set>
+#include <cmath>
+#include <algorithm>
+#include <cstdarg>
+#include <cstdlib>
+#include <cstring>
+#include <atomic>
+
+namespace mvkfov {
+
+static bool envOn(const char* name, bool dflt) {
+	const char* v = getenv(name);
+	if ( !v || !*v ) { return dflt; }
+	return !(v[0] == '0' || v[0] == 'n' || v[0] == 'N' || v[0] == 'f' || v[0] == 'F');
+}
+
+bool isEnabled() {
+	static int on = -1;
+	if (on < 0) { on = envOn("KL_FOVEATE", false) ? 1 : 0; }
+	return on;
+}
+
+static std::mutex s_logLock;
+void logOnce(const char* key, const char* fmt, ...) {
+	static std::set<std::string> seen;
+	{
+		std::lock_guard<std::mutex> lock(s_logLock);
+		if ( !seen.insert(key).second ) { return; }
+	}
+	va_list ap;
+	va_start(ap, fmt);
+	vfprintf(stderr, fmt, ap);
+	va_end(ap);
+}
+
+#pragma mark Rate profile
+
+// A profile is a list of half-axis zones from the centre out: (fraction of the
+// half extent, rate). Both axes use the same profile, mirrored about the centre.
+// Rates below ~0.25 buy little (the unwarp still writes every pixel) and look
+// coarse, so the presets stop there.
+struct Zone { float frac, rate; };
+
+static std::vector<Zone> presetProfile(int level) {
+	switch (level) {
+		case 1:  return { {0.45f, 1.0f}, {0.30f, 0.75f}, {0.25f, 0.5f} };	// ~0.80 per axis, ~64% of fragments
+		case 3:  return { {0.25f, 1.0f}, {0.30f, 0.5f},  {0.45f, 0.25f} };	// ~0.51 per axis, ~26%
+		case 2:
+		default: return { {0.35f, 1.0f}, {0.30f, 0.5f},  {0.35f, 0.33f} };	// ~0.62 per axis, ~38%
+	}
+}
+
+static const std::vector<Zone>& profile(int* outLevel) {
+	static std::vector<Zone> prof;
+	static int level = 0;
+	static std::once_flag once;
+	std::call_once(once, []() {
+		const char* lv = getenv("KL_FOVEATE_LEVEL");
+		level = lv ? atoi(lv) : 2;
+		if (level < 1 || level > 3) { level = 2; }
+		prof = presetProfile(level);
+		// KL_FOVEATE_PROFILE="0.35:1,0.3:0.5,0.35:0.33" overrides the level.
+		if (const char* p = getenv("KL_FOVEATE_PROFILE")) {
+			std::vector<Zone> custom;
+			float total = 0;
+			const char* s = p;
+			while (*s) {
+				char* end = nullptr;
+				float f = strtof(s, &end);
+				if (end == s || *end != ':') { custom.clear(); break; }
+				s = end + 1;
+				float r = strtof(s, &end);
+				if (end == s) { custom.clear(); break; }
+				s = end;
+				if (*s == ',') { s++; }
+				if (f <= 0 || r <= 0 || r > 1) { custom.clear(); break; }
+				custom.push_back({f, r});
+				total += f;
+			}
+			if ( !custom.empty() && total > 0 ) {
+				for (auto& z : custom) { z.frac /= total; }
+				prof = custom;
+				level = 0;
+			} else {
+				fprintf(stderr, "[mvk-fov] KL_FOVEATE_PROFILE \"%s\" not understood (want f:r,f:r,...) — level %d\n", p, level);
+			}
+		}
+	});
+	if (outLevel) { *outLevel = level; }
+	return prof;
+}
+
+// Rate at a normalised position t in [0, 1] along an axis.
+static float rateAt(const std::vector<Zone>& prof, float t) {
+	float u = fabsf(t - 0.5f) * 2.0f;	// 0 at the centre, 1 at the edge
+	float acc = 0;
+	for (auto& z : prof) {
+		acc += z.frac;
+		if (u <= acc + 1e-6f) { return z.rate; }
+	}
+	return prof.empty() ? 1.0f : prof.back().rate;
+}
+
+#pragma mark Rate maps
+
+static std::mutex s_mapLock;
+static std::vector<RateMap*> s_maps;
+
+const RateMap* getRateMap(id<MTLDevice> mtlDev, uint32_t w, uint32_t h, uint32_t layers, bool identity) {
+	if ( !mtlDev || !w || !h || !layers ) { return nullptr; }
+	std::lock_guard<std::mutex> lock(s_mapLock);
+	for (auto* m : s_maps) {
+		if (m->screenW == w && m->screenH == h && m->layers == layers && m->identity == identity) { return m; }
+	}
+	if ( ![mtlDev supportsRasterizationRateMapWithLayerCount: layers] ) {
+		char key[64];
+		snprintf(key, sizeof(key), "nolayers:%u", layers);
+		logOnce(key, "[mvk-fov] this GPU has no rasterization rate map with %u layer(s) — full rate\n", layers);
+		return nullptr;
+	}
+
+	int level = 0;
+	const auto& prof = profile(&level);
+	// Metal's zones are EQUAL slices of the screen, one rate each; a profile with
+	// uneven zones is sampled at each slice's centre. 32 slices per axis is ~140 px
+	// at the Vision Pro's ~4600 px eye width, finer than any profile edge needs.
+	const uint32_t n = identity ? 1 : 32;
+	@autoreleasepool {
+		MTLRasterizationRateMapDescriptor* desc = [MTLRasterizationRateMapDescriptor rasterizationRateMapDescriptorWithScreenSize: MTLSizeMake(w, h, 0)];
+		for (uint32_t l = 0; l < layers; l++) {
+			MTLRasterizationRateLayerDescriptor* ld = [[MTLRasterizationRateLayerDescriptor alloc] initWithSampleCount: MTLSizeMake(n, n, 0)];
+			for (uint32_t i = 0; i < n; i++) {
+				float r = identity ? 1.0f : rateAt(prof, (i + 0.5f) / n);
+				ld.horizontalSampleStorage[i] = r;
+				ld.verticalSampleStorage[i] = r;
+			}
+			[desc setLayer: ld atIndex: l];
+			[ld release];
+		}
+		desc.label = identity ? @"Klepton identity rate map" : @"Klepton foveation rate map";
+		id<MTLRasterizationRateMap> map = [mtlDev newRasterizationRateMapWithDescriptor: desc];	// retained
+		if ( !map ) {
+			char key[64];
+			snprintf(key, sizeof(key), "mapfail:%ux%u:%u", w, h, layers);
+			logOnce(key, "[mvk-fov] newRasterizationRateMap %ux%u x%u refused by Metal — full rate\n", w, h, layers);
+			return nullptr;
+		}
+		MTLSizeAndAlign pb = map.parameterBufferSizeAndAlign;
+		id<MTLBuffer> params = [mtlDev newBufferWithLength: mvkAlignByteCount(pb.size, pb.align) options: MTLResourceStorageModeShared];	// retained
+		[map copyParameterDataToBuffer: params offset: 0];
+
+		auto* rm = new RateMap();
+		rm->map = map;
+		rm->params = params;
+		rm->physical = [map physicalSizeForLayer: 0];
+		for (uint32_t l = 1; l < layers; l++) {
+			MTLSize p = [map physicalSizeForLayer: l];
+			rm->physical.width = std::max(rm->physical.width, p.width);
+			rm->physical.height = std::max(rm->physical.height, p.height);
+		}
+		rm->screenW = w;
+		rm->screenH = h;
+		rm->layers = layers;
+		rm->identity = identity;
+		rm->fragmentRatio = double(rm->physical.width) * rm->physical.height / (double(w) * h);
+
+		// Bounded: dynamic resolution makes a new size now and then. Maps are small
+		// (a parameter buffer of a few tens of KB); drop the oldest past 32.
+		if (s_maps.size() >= 32) {
+			// Not freed: a command buffer in flight may still reference it. Leaking
+			// a handful over a session is the safe trade.
+			s_maps.erase(s_maps.begin());
+		}
+		s_maps.push_back(rm);
+
+		if ( !identity ) {
+			fprintf(stderr, "[mvk-fov] rate map %ux%u x%u layer(s), %s %d: physical %lux%lu = %.0f%% of the fragments (granularity %lux%lu)\n",
+					w, h, layers, level ? "level" : "custom profile", level,
+					(unsigned long)rm->physical.width, (unsigned long)rm->physical.height, rm->fragmentRatio * 100.0,
+					(unsigned long)map.physicalGranularity.width, (unsigned long)map.physicalGranularity.height);
+		}
+		return rm;
+	}
+}
+
+#pragma mark Shadows
+
+struct ShadowEntry {
+	MTLPixelFormat fmt;
+	NSUInteger samples, w, h, layers;
+	MTLStorageMode storage;
+	uint32_t slot;
+	id<MTLTexture> tex;
+	id<MTLTexture> stencilView;		// lazily, for the stencil unwarp
+	uint64_t lastUse;
+};
+static std::mutex s_shadowLock;
+static std::vector<ShadowEntry> s_shadows;
+static uint64_t s_shadowClock = 0;
+
+MTLPixelFormat stencilViewFormat(MTLPixelFormat fmt);
+
+id<MTLTexture> getShadowStencilView(id<MTLTexture> shadow) {
+	std::lock_guard<std::mutex> lock(s_shadowLock);
+	for (auto& e : s_shadows) {
+		if (e.tex != shadow) { continue; }
+		if ( !e.stencilView ) {
+			MTLPixelFormat sf = stencilViewFormat(e.fmt);
+			if (sf != MTLPixelFormatInvalid) { e.stencilView = [e.tex newTextureViewWithPixelFormat: sf]; }	// retained
+		}
+		return e.stencilView;
+	}
+	return nil;
+}
+
+id<MTLTexture> getShadow(id<MTLDevice> mtlDev, id<MTLTexture> real, MTLSize physical, uint32_t layers, uint32_t slot,
+						 id<MTLCommandBuffer> mtlCmdBuff) {
+	if ( !mtlDev || !real ) { return nil; }
+	MTLStorageMode storage = real.storageMode == MTLStorageModeMemoryless ? MTLStorageModeMemoryless : MTLStorageModePrivate;
+	std::lock_guard<std::mutex> lock(s_shadowLock);
+	s_shadowClock++;
+	for (auto& e : s_shadows) {
+		if (e.fmt == real.pixelFormat && e.samples == real.sampleCount && e.w == physical.width && e.h == physical.height &&
+			e.layers == layers && e.storage == storage && e.slot == slot) {
+			e.lastUse = s_shadowClock;
+			return e.tex;
+		}
+	}
+	@autoreleasepool {
+		MTLTextureDescriptor* td = [MTLTextureDescriptor new];		// retained
+		td.textureType = real.sampleCount > 1 ? MTLTextureType2DMultisampleArray : MTLTextureType2DArray;
+		td.pixelFormat = real.pixelFormat;
+		td.width = physical.width;
+		td.height = physical.height;
+		td.arrayLength = layers;
+		td.sampleCount = real.sampleCount;
+		td.mipmapLevelCount = 1;
+		td.storageMode = storage;
+		td.usage = MTLTextureUsageRenderTarget | (storage == MTLStorageModeMemoryless ? 0 : MTLTextureUsageShaderRead);
+		// The stencil unwarp reads the stencil plane through an X32_Stencil8 view.
+		if (storage != MTLStorageModeMemoryless && stencilViewFormat(real.pixelFormat) != MTLPixelFormatInvalid) {
+			td.usage |= MTLTextureUsagePixelFormatView;
+		}
+		id<MTLTexture> tex = [mtlDev newTextureWithDescriptor: td];	// retained
+		[td release];
+		if ( !tex ) { return nil; }
+		tex.label = @"Klepton foveation shadow";
+		{
+			char key[96];
+			snprintf(key, sizeof(key), "shadow:%lu:%lu:%u:%lu", (unsigned long)real.pixelFormat, (unsigned long)real.sampleCount, slot, (unsigned long)storage);
+			double mb = double(tex.allocatedSize) / (1024.0 * 1024.0);
+			logOnce(key, "[mvk-fov] shadow for slot %u: pixel format %lu, %lux%lu x%u, %lu sample(s), %s (%.0f MB)\n", slot,
+					(unsigned long)real.pixelFormat, (unsigned long)physical.width, (unsigned long)physical.height, layers,
+					(unsigned long)real.sampleCount, storage == MTLStorageModeMemoryless ? "memoryless (tile only)" : "private", mb);
+		}
+		// Pooled, bounded: past 48 shadows the least recently used goes. MoltenVK's
+		// command buffers do NOT retain what they reference (retainedReferences = NO),
+		// so the release waits for the command buffer being encoded to complete — on
+		// one queue that is after every earlier one that could still use it.
+		if (s_shadows.size() >= 48) {
+			auto lru = std::min_element(s_shadows.begin(), s_shadows.end(),
+										[](const ShadowEntry& a, const ShadowEntry& b) { return a.lastUse < b.lastUse; });
+			id<MTLTexture> old = lru->tex, oldView = lru->stencilView;
+			if (mtlCmdBuff) {
+				[mtlCmdBuff addCompletedHandler: ^(id<MTLCommandBuffer>) { [oldView release]; [old release]; }];
+			}	// else leaked: safe, and only without a command buffer, which callers never do
+			s_shadows.erase(lru);
+		}
+		s_shadows.push_back({ real.pixelFormat, real.sampleCount, physical.width, physical.height, layers, storage, slot, tex, nil, s_shadowClock });
+		return tex;
+	}
+}
+
+#pragma mark Unwarp
+
+// One vertex function (a full-screen triangle per instance, the instance being the
+// layer) and two fragment functions. The unwarp pass has NO rate map: [[position]]
+// is a screen pixel, which the decoder maps into the shadow's physical space.
+static const char* s_unwarpMSL = R"MSL(
+#include <metal_stdlib>
+using namespace metal;
+
+struct KLFovVO {
+	float4 pos [[position]];
+	uint layer [[render_target_array_index]];
+};
+
+vertex KLFovVO klFovVS(uint vid [[vertex_id]], uint iid [[instance_id]]) {
+	float2 uv = float2((vid << 1) & 2, vid & 2);
+	KLFovVO o;
+	o.pos = float4(uv * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
+	o.layer = iid;
+	return o;
+}
+
+fragment float4 klFovUnwarpColor(KLFovVO in [[stage_in]],
+								 constant rasterization_rate_map_data& rm [[buffer(0)]],
+								 constant uint& opts [[buffer(1)]],
+								 texture2d_array<float> src [[texture(0)]]) {
+	rasterization_rate_map_decoder dec(rm);
+	float2 p = dec.map_screen_to_physical_coordinates(in.pos.xy, in.layer);
+	float2 size = float2(src.get_width(), src.get_height());
+	constexpr sampler lin(coord::normalized, filter::linear, address::clamp_to_edge);
+	constexpr sampler pt(coord::normalized, filter::nearest, address::clamp_to_edge);
+	float4 c = (opts & 1u) ? src.sample(pt, p / size, in.layer) : src.sample(lin, p / size, in.layer);
+	if (opts & 2u) {
+		// Debug: physical pixels per screen pixel < 1 means a reduced rate here.
+		float r = min(abs(dfdx(p.x)), abs(dfdy(p.y)));
+		if (r < 0.95) { c.rgb = mix(c.rgb, float3(1.0, 0.0, 0.0), r < 0.4 ? 0.35 : 0.18); }
+	}
+	return c;
+}
+
+struct KLFovDepthOut { float depth [[depth(any)]]; };
+
+fragment KLFovDepthOut klFovUnwarpDepth(KLFovVO in [[stage_in]],
+										constant rasterization_rate_map_data& rm [[buffer(0)]],
+										depth2d_array<float> src [[texture(0)]]) {
+	rasterization_rate_map_decoder dec(rm);
+	float2 p = dec.map_screen_to_physical_coordinates(in.pos.xy, in.layer);
+	uint2 ip = uint2(clamp(p, float2(0.0), float2(src.get_width() - 1, src.get_height() - 1)));
+	KLFovDepthOut o;
+	o.depth = src.read(ip, in.layer);
+	return o;
+}
+
+struct KLFovDepthStencilOut { float depth [[depth(any)]]; uint stencil [[stencil]]; };
+
+fragment KLFovDepthStencilOut klFovUnwarpDepthStencil(KLFovVO in [[stage_in]],
+													  constant rasterization_rate_map_data& rm [[buffer(0)]],
+													  depth2d_array<float> src [[texture(0)]],
+													  texture2d_array<uint> stencil [[texture(1)]]) {
+	rasterization_rate_map_decoder dec(rm);
+	float2 p = dec.map_screen_to_physical_coordinates(in.pos.xy, in.layer);
+	uint2 ip = uint2(clamp(p, float2(0.0), float2(src.get_width() - 1, src.get_height() - 1)));
+	KLFovDepthStencilOut o;
+	o.depth = src.read(ip, in.layer);
+	o.stencil = stencil.read(ip, in.layer).r;
+	return o;
+}
+)MSL";
+
+static std::mutex s_psoLock;
+static id<MTLLibrary> s_unwarpLib = nil;
+static id<MTLDepthStencilState> s_depthStates[8] = {};
+struct PSOEntry { MTLPixelFormat fmt; uint8_t kind; id<MTLRenderPipelineState> pso; };
+static std::vector<PSOEntry> s_psos;
+
+MTLPixelFormat stencilViewFormat(MTLPixelFormat fmt) {
+	switch (fmt) {
+		case MTLPixelFormatDepth32Float_Stencil8: return MTLPixelFormatX32_Stencil8;
+#if MVK_MACOS
+		case MTLPixelFormatDepth24Unorm_Stencil8: return MTLPixelFormatX24_Stencil8;
+#endif
+		case MTLPixelFormatStencil8:              return MTLPixelFormatStencil8;
+		default:                                  return MTLPixelFormatInvalid;
+	}
+}
+
+static bool hasDepth(MTLPixelFormat fmt) {
+	switch (fmt) {
+		case MTLPixelFormatDepth16Unorm:
+		case MTLPixelFormatDepth32Float:
+		case MTLPixelFormatDepth32Float_Stencil8:
+#if MVK_MACOS
+		case MTLPixelFormatDepth24Unorm_Stencil8:
+#endif
+			return true;
+		default:
+			return false;
+	}
+}
+
+id<MTLRenderPipelineState> getUnwarpPipeline(id<MTLDevice> mtlDev, MTLPixelFormat fmt, uint8_t kind) {
+	std::lock_guard<std::mutex> lock(s_psoLock);
+	for (auto& e : s_psos) {
+		if (e.fmt == fmt && e.kind == kind) { return e.pso; }
+	}
+	@autoreleasepool {
+		NSError* err = nil;
+		if ( !s_unwarpLib ) {
+			s_unwarpLib = [mtlDev newLibraryWithSource: @(s_unwarpMSL) options: nil error: &err];	// retained
+			if ( !s_unwarpLib ) {
+				fprintf(stderr, "[mvk-fov] unwarp shaders failed to compile: %s\n", err.localizedDescription.UTF8String);
+				return nil;
+			}
+		}
+		bool isColor = kind & kMVKFovUnwarpColor;
+		bool wantStencil = (kind & kMVKFovUnwarpStencil) && stencilViewFormat(fmt) != MTLPixelFormatInvalid;
+		NSString* fsName = isColor ? @"klFovUnwarpColor" : (wantStencil ? @"klFovUnwarpDepthStencil" : @"klFovUnwarpDepth");
+		MTLRenderPipelineDescriptor* pd = [MTLRenderPipelineDescriptor new];		// retained
+		id<MTLFunction> vs = [s_unwarpLib newFunctionWithName: @"klFovVS"];
+		id<MTLFunction> fs = [s_unwarpLib newFunctionWithName: fsName];
+		pd.vertexFunction = vs;
+		pd.fragmentFunction = fs;
+		pd.inputPrimitiveTopology = MTLPrimitiveTopologyClassTriangle;
+		pd.label = @"Klepton foveation unwarp";
+		if (isColor) {
+			pd.colorAttachments[0].pixelFormat = fmt;
+		} else {
+			if (hasDepth(fmt)) { pd.depthAttachmentPixelFormat = fmt; }
+			if (stencilViewFormat(fmt) != MTLPixelFormatInvalid) { pd.stencilAttachmentPixelFormat = fmt; }
+		}
+		id<MTLRenderPipelineState> pso = [mtlDev newRenderPipelineStateWithDescriptor: pd error: &err];	// retained
+		[vs release];
+		[fs release];
+		[pd release];
+		char key[64];
+		snprintf(key, sizeof(key), "pso:%lu:%d", (unsigned long)fmt, kind);
+		if ( !pso ) {
+			logOnce(key, "[mvk-fov] no unwarp pipeline for pixel format %lu (kind %d, %s): %s — that attachment is NOT unwarped\n",
+					(unsigned long)fmt, kind, fsName.UTF8String, err.localizedDescription.UTF8String);
+		} else {
+			logOnce(key, "[mvk-fov] unwarp pipeline: pixel format %lu, %s\n", (unsigned long)fmt, fsName.UTF8String);
+		}
+		s_psos.push_back({ fmt, kind, pso });
+		return pso;
+	}
+}
+
+id<MTLDepthStencilState> getUnwarpDepthState(id<MTLDevice> mtlDev, uint8_t kind) {
+	std::lock_guard<std::mutex> lock(s_psoLock);
+	uint8_t k = kind & (kMVKFovUnwarpDepth | kMVKFovUnwarpStencil);
+	if ( !s_depthStates[k] ) {
+		MTLDepthStencilDescriptor* dd = [MTLDepthStencilDescriptor new];
+		dd.depthCompareFunction = MTLCompareFunctionAlways;
+		dd.depthWriteEnabled = (k & kMVKFovUnwarpDepth) ? YES : NO;
+		if (k & kMVKFovUnwarpStencil) {
+			// The reference value is the shader's [[stencil]] output.
+			MTLStencilDescriptor* sd = [MTLStencilDescriptor new];
+			sd.stencilCompareFunction = MTLCompareFunctionAlways;
+			sd.stencilFailureOperation = MTLStencilOperationReplace;
+			sd.depthFailureOperation = MTLStencilOperationReplace;
+			sd.depthStencilPassOperation = MTLStencilOperationReplace;
+			sd.readMask = 0xFF;
+			sd.writeMask = 0xFF;
+			dd.frontFaceStencil = sd;
+			dd.backFaceStencil = sd;
+			[sd release];
+		}
+		s_depthStates[k] = [mtlDev newDepthStencilStateWithDescriptor: dd];
+		[dd release];
+	}
+	return s_depthStates[k];
+}
+
+bool isDepthUnwarpEnabled() {
+	static int on = -1;
+	if (on < 0) {
+		on = envOn("KL_FOVEATE_DEPTH", true) ? 1 : 0;
+		if ( !on ) { fprintf(stderr, "[mvk-fov] KL_FOVEATE_DEPTH=0: depth/stencil is NOT unwarped (diagnostic; later passes see stale depth)\n"); }
+	}
+	return on;
+}
+
+uint32_t getUnwarpOptions() {
+	static int opts = -1;
+	if (opts < 0) {
+		const char* u = getenv("KL_FOVEATE_UNWARP");
+		opts = (u && !strcmp(u, "nearest")) ? 1 : 0;
+		if (envOn("KL_FOVEATE_DEBUG", false)) { opts |= 2; }
+	}
+	return (uint32_t)opts;
+}
+
+#pragma mark Statistics
+
+static double abPeriod() {
+	static double p = -1;
+	if (p < 0) {
+		const char* v = getenv("KL_FOVEATE_AB");
+		p = v ? atof(v) : 0;
+		if ( !(p >= 1.0) ) { p = 0; }
+		if (p > 0) { fprintf(stderr, "[mvk-fov] KL_FOVEATE_AB=%.0f: foveation alternates ON/OFF every %.0f s in this run (per-phase GPU ms/frame below)\n", p, p); }
+	}
+	return p;
+}
+static std::mutex s_abLock;
+static double s_abT0 = 0;
+// Phase of time t: 0 = ON, 1 = OFF; -1 inside the first second after a flip (GPU work
+// encoded in the old phase may still be completing — not attributed to either).
+static int abPhaseAt(double t) {
+	double p = abPeriod();
+	if (p <= 0) { return 0; }
+	std::lock_guard<std::mutex> lock(s_abLock);
+	if (s_abT0 == 0) { s_abT0 = t; }
+	double x = (t - s_abT0) / p;
+	if (x < 0) { return -1; }
+	double frac = x - floor(x);
+	if (frac * p < 1.0) { return -1; }
+	return int(floor(x)) & 1;
+}
+
+bool isGPUTimeEnabled() {
+	static int on = -1;
+	if (on < 0) { on = (envOn("KL_MVK_GPU_TIME", false) || abPeriod() > 0) ? 1 : 0; }
+	return on;
+}
+
+// Klepton's live switch (klMVKFoveationSetEnabled): the quick settings turn
+// foveation off and on while the game runs. Off is the A/B's off phase for
+// every instance, so passes and pipelines stay as built.
+static std::atomic<bool> s_liveOff{false};
+
+bool isABOffPhase() {
+	if (s_liveOff.load(std::memory_order_relaxed)) { return true; }
+	return abPeriod() > 0 && abPhaseAt(CACurrentMediaTime()) == 1;
+}
+
+static std::mutex s_statLock;
+static double s_winStart = 0, s_busy = 0, s_lastEnd = 0;
+static uint32_t s_cbCount = 0, s_fovFrames = 0, s_fullFrames = 0;
+// In-process A/B accumulators, per phase: GPU busy seconds, frames, settled phase seconds.
+static double s_abBusy[2] = {0, 0}, s_abSpan[2] = {0, 0}, s_abLastT = 0;
+static uint32_t s_abFrames[2] = {0, 0};
+static int s_abLastPhase = -2;
+
+static void maybeReport(double now) {
+	// Called with s_statLock held. `now` is CACurrentMediaTime-based (as GPU times are).
+	if (s_winStart == 0) { s_winStart = now; return; }
+	double span = now - s_winStart;
+	if (span < 5.0) { return; }
+	uint32_t frames = s_fovFrames + s_fullFrames;
+	if (isGPUTimeEnabled()) {
+		fprintf(stderr, "[mvk-fov] GPU busy %.1f ms per second (%.0f%%) over %u command buffers; density-map frames %u foveated, %u full rate",
+				s_busy * 1000.0 / span, s_busy * 100.0 / span, s_cbCount, s_fovFrames, s_fullFrames);
+		if (frames) { fprintf(stderr, " -> %.2f GPU ms per frame", s_busy * 1000.0 / frames); }
+		fprintf(stderr, " (last %.1f s)\n", span);
+	} else if (frames) {
+		fprintf(stderr, "[mvk-fov] density-map frames: %u foveated, %u full rate (last %.1f s)\n", s_fovFrames, s_fullFrames, span);
+	}
+	if (abPeriod() > 0 && s_abFrames[0] && s_abFrames[1]) {
+		double on = s_abBusy[0] * 1000.0 / s_abFrames[0], off = s_abBusy[1] * 1000.0 / s_abFrames[1];
+		double fpsOn = s_abSpan[0] > 0 ? s_abFrames[0] / s_abSpan[0] : 0, fpsOff = s_abSpan[1] > 0 ? s_abFrames[1] / s_abSpan[1] : 0;
+		fprintf(stderr, "[mvk-fov] A/B so far: foveated %.2f GPU ms/frame at %.1f fps (%u frames) | full rate %.2f GPU ms/frame at %.1f fps (%u frames) | %+.1f%% GPU time\n",
+				on, fpsOn, s_abFrames[0], off, fpsOff, s_abFrames[1], off > 0 ? (on - off) * 100.0 / off : 0.0);
+	}
+	s_winStart = now;
+	s_busy = 0;
+	s_cbCount = 0;
+	s_fovFrames = s_fullFrames = 0;
+}
+
+// The union of every command buffer's [GPUStartTime, GPUEndTime], so overlapping
+// command buffers (several queues, or the GPU pipelining two) are not counted twice.
+// Completion handlers arrive in completion order, which for one queue is start order.
+// In an A/B, a command buffer's time goes to the phase it STARTED in.
+void noteGPUTime(double start, double end) {
+	if (end <= start || start <= 0) { return; }
+	int ph = abPeriod() > 0 ? abPhaseAt(start) : -1;
+	std::lock_guard<std::mutex> lock(s_statLock);
+	double from = std::max(start, s_lastEnd);
+	double add = end > from ? end - from : 0;
+	s_busy += add;
+	s_lastEnd = std::max(s_lastEnd, end);
+	s_cbCount++;
+	if (ph >= 0) { s_abBusy[ph] += add; }
+	maybeReport(end);
+}
+
+void noteFrame(bool foveated) {
+	double now = CACurrentMediaTime();
+	int ph = abPeriod() > 0 ? abPhaseAt(now) : -1;
+	std::lock_guard<std::mutex> lock(s_statLock);
+	if (foveated) { s_fovFrames++; } else { s_fullFrames++; }
+	if (abPeriod() > 0) {
+		if (s_abLastT > 0 && ph >= 0 && ph == s_abLastPhase) { s_abSpan[ph] += now - s_abLastT; }
+		s_abLastT = now;
+		s_abLastPhase = ph;
+		if (ph >= 0) { s_abFrames[ph]++; }
+	}
+	if ( !isGPUTimeEnabled() ) { maybeReport(now); }
+}
+
