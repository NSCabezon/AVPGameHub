{
  "sourceLanguage": "en",
  "strings": {
    "Open game settings in ${applicationName}": {
      "localizations": {
        "es": {
          "stringSet": {
            "state": "translated",
            "values": [
              "Abre ajustes del juego en ${applicationName}",
              "Abre los ajustes del juego en ${applicationName}"
            ]
          }
        }
      }
    },
    "Close game settings in ${applicationName}": {
      "localizations": {
        "es": {
          "stringSet": {
            "state": "translated",
            "values": [
              "Cierra ajustes del juego en ${applicationName}",
              "Cierra los ajustes del juego en ${applicationName}"
            ]
          }
        }
      }
    },
    "Turn on the FPS overlay in ${applicationName}": {
      "localizations": {
        "es": {
          "stringSet": {
            "state": "translated",
            "values": [
              "Activa el visor de FPS en ${applicationName}"
            ]
          }
        }
      }
    },
    "Show the FPS counter in ${applicationName}": {
      "localizations": {
        "es": {
          "stringSet": {
            "state": "translated",
            "values": [
              "Muestra el contador de FPS en ${applicationName}",
              "Enseña los FPS en ${applicationName}"
            ]
          }
        }
      }
    },
    "Turn off the FPS overlay in ${applicationName}": {
      "localizations": {
        "es": {
          "stringSet": {
            "state": "translated",
            "values": [
              "Desactiva el visor de FPS en ${applicationName}"
            ]
          }
        }
      }
    },
    "Hide the FPS counter in ${applicationName}": {
      "localizations": {
        "es": {
          "stringSet": {
            "state": "translated",
            "values": [
              "Oculta el contador de FPS en ${applicationName}",
              "Quita los FPS en ${applicationName}"
            ]
          }
        }
      }
    },
    "Toggle the FPS overlay in ${applicationName}": {
      "localizations": {
        "es": {
          "stringSet": {
            "state": "translated",
            "values": [
              "Alterna el visor de FPS en ${applicationName}"
            ]
          }
        }
      }
    },
    "Set antialiasing to ${level} in ${applicationName}": {
      "localizations": {
        "es": {
          "stringSet": {
            "state": "translated",
            "values": [
              "Pon el antialiasing a ${level} en ${applicationName}"
            ]
          }
        }
      }
    },
    "Turn on foveated rendering in ${applicationName}": {
      "localizations": {
        "es": {
          "stringSet": {
            "state": "translated",
            "values": [
              "Activa el renderizado foveado en ${applicationName}"
            ]
          }
        }
      }
    },
    "Turn on foveation in ${applicationName}": {
      "localizations": {
        "es": {
          "stringSet": {
            "state": "translated",
            "values": [
              "Activa el foveated en ${applicationName}"
            ]
          }
        }
      }
    },
    "Turn off foveated rendering in ${applicationName}": {
      "localizations": {
        "es": {
          "stringSet": {
            "state": "translated",
            "values": [
              "Desactiva el renderizado foveado en ${applicationName}"
            ]
          }
        }
      }
    },
    "Turn off foveation in ${applicationName}": {
      "localizations": {
        "es": {
          "stringSet": {
            "state": "translated",
